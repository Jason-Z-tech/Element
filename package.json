{
  "name": "elementjaeger",
  "private": true,
  "version": "0.1.0",
  "description": "Elementjäger – gemeinsam nach neuen superschweren Elementen rechnen (Simulation)",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
